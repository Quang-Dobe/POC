<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Api</RootNamespace>
    <AssemblyName>Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Step C — the secret-store reader seam (internal test overload + concrete readers)
         is exercised by the unit tests with fake readers and zero network. -->
    <InternalsVisibleTo Include="Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Step D — JWT bearer validation. ONE AddJwtBearer registration; authority/audience
         from AuthOptions, issuer + signing keys auto-discover via OIDC. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Step C — dual secret store. PROD: Key Vault config provider + DefaultAzureCredential
         (the eager reader uses SecretClient from Azure.Security.KeyVault.Secrets, pulled in
         transitively by the Configuration.Secrets package; pinned explicitly for clarity).
         DEV: OpenBAO (Vault-compatible KV v2) via VaultSharp. -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.6.0" />
    <PackageReference Include="Azure.Identity" Version="1.12.1" />
    <PackageReference Include="VaultSharp" Version="1.17.5.1" />
  </ItemGroup>

</Project>
