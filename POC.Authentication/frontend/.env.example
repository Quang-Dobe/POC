# Frontend build-time environment (Vite bakes VITE_* at build time => build-per-env).
#
# This file is the COMMITTED template. It contains NO secrets — the FE is a public
# PKCE client and never holds a client secret (secrets-dual-provider).
#
# Local setup: copy the block you need into an UNTRACKED file Vite loads automatically:
#   - DEV build  -> .env.development   (or .env.local)
#   - PROD build -> .env.production
# Those .env.development / .env.production files are gitignored — create them locally;
# do NOT commit them. One flat set of VITE_* values is active per build.

# ----------------------------------------------------------------------------
# DEV (Keycloak + OpenBAO) — concrete values; these pin the Step G realm contract.
# ----------------------------------------------------------------------------
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/poc
# Public SPA client registered in the `poc` realm (PKCE, no secret).
VITE_OIDC_CLIENT_ID=poc-spa
# `poc-api` is the client scope that triggers the Keycloak Audience mapper so the
# API client lands in the token `aud` (Step G realm export must define it).
VITE_OIDC_SCOPE="openid profile poc-api"
# Backend API origin (placeholder — Step G compose binds the real backend port).
VITE_API_BASE_URL=http://localhost:5000
# Must match the IdP client redirect registration and the FE `/callback` route.
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback

# ----------------------------------------------------------------------------
# PROD (Azure Entra ID + Azure Key Vault) — TEMPLATE ONLY. Fill <placeholders>
# locally in an untracked .env.production. Entra constraints (oidc-dual-idp R1):
#   - authority MUST end in `/v2.0`
#   - request the API scope `api://<api-client-id>/<scope>` (a Graph scope is NOT
#     valid for the API); the Entra app manifest must set accessTokenAcceptedVersion: 2
# ----------------------------------------------------------------------------
# VITE_OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
# VITE_OIDC_CLIENT_ID=<spa-client-id>
# VITE_OIDC_SCOPE="openid profile api://<api-client-id>/<scope>"
# VITE_API_BASE_URL=https://<backend-host>
# VITE_OIDC_REDIRECT_URI=https://<spa-host>/callback
