# ONE template for BOTH .env.dev and .env.prod. Variable NAMES are identical across
# environments; only VALUES differ (provider-specific keys are marked DEV-only / PROD-only).
#   cp .env.example .env.dev    # keep the DEV values
#   cp .env.example .env.prod   # switch to the `# PROD:` values

KEYCLOAK_HOST=localhost        # DEV only
KEYCLOAK_PORT=8080             # DEV only
OPENBAO_HOST=localhost         # DEV only
OPENBAO_PORT=8200              # DEV only
BE_HOST=localhost
BE_PORT=5000
FE_HOST=localhost
FE_PORT=5173
DAB_HOST=localhost
DAB_PORT=8000
AGENT_HOST=localhost
AGENT_PORT=8082
BAO_TOKEN=dev-only-token       # DEV only

TENANT_ID=poc
# PROD: TENANT_ID=<tenant-guid>
AUTH_AUTHORITY=https://${KEYCLOAK_HOST}:${KEYCLOAK_PORT}/realms/${TENANT_ID}
# PROD: AUTH_AUTHORITY=https://login.microsoftonline.com/${TENANT_ID}/v2.0
AUTH_APP_CLIENT_ID=poc-spa
# PROD: AUTH_APP_CLIENT_ID=<spa-client-id-guid>
AUTH_API_CLIENT_ID=poc-api
# PROD: AUTH_API_CLIENT_ID=<api-client-id-guid>
AUTH_DAB_CLIENT_ID=poc-dab
# PROD: AUTH_DAB_CLIENT_ID=<poc-dab-app-client-id-or-application-id-uri>
AUTH_AGENT_CLIENT_ID=agent-gateway
# PROD: AUTH_AGENT_CLIENT_ID=<agent-client-id>
AUTH_AGENT_CLIENT_SECRET=agent-gateway-dev-secret   # must match realm-export.json client secret
# PROD: AUTH_AGENT_CLIENT_SECRET=<agent-client-secret>


# ---- Frontend ----
VITE_OIDC_AUTHORITY=${AUTH_AUTHORITY}
VITE_OIDC_CLIENT_ID=${AUTH_APP_CLIENT_ID}
VITE_OIDC_SCOPE=openid profile poc-api
# PROD: VITE_OIDC_SCOPE="openid profile api://${AUTH_API_CLIENT_ID}/access_as_user"
VITE_OIDC_REDIRECT_URI=http://${FE_HOST}:${FE_PORT}/callback
VITE_API_BASE_URL=http://${BE_HOST}:${BE_PORT}


# ---- Backend ----
VAULT_ADDRESS=http://${OPENBAO_HOST}:${OPENBAO_PORT}     # DEV only (OpenBAO)
# PROD (instead of VAULT_ADDRESS) — Azure Key Vault + the Entra app the BE authenticates with:
# KEYVAULT_VAULT_URI=https://<vault-name>.vault.azure.net/
# AZURE_CLIENT_ID=${AUTH_APP_CLIENT_ID}
# AZURE_CLIENT_SECRET=<sp-client-secret-value>           # the one true secret
CORS_SPA_ORIGIN=http://${FE_HOST}:${FE_PORT}


# ---- Agent Gateway Service ----
AGENT_GATEWAY_ENABLED=true
# PROD: AGENT_GATEWAY_ENABLED=false

AZ_FOUNDRY_TENANT_ID=<sp-tenant-id>
AZ_FOUNDRY_SP_CLIENT_ID=<sp-client-id>
AZ_FOUNDRY_SP_CLIENT_SECRET=<sp-client-secret>
AZ_FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZ_FOUNDRY_MODEL_DEPLOYMENT_NAME=<model-deployment-name>


# ---- DAB ----
DAB_ENVIRONMENT=Development
# PROD: DAB_ENVIRONMENT=Production
# DEV = interactive Fabric (no secret in the string):
FABRIC_CONN_STRING=Server=<id>.datawarehouse.fabric.microsoft.com;Database=<WarehouseName>;Authentication=Active Directory Interactive;Encrypt=True;TrustServerCertificate=False;
# PROD (service principal — the SP secret is INSIDE this string):
# FABRIC_CONN_STRING=Server=<id>...;Authentication=Active Directory Service Principal;User Id=<spClientId>;Password=<spClientSecret>;Encrypt=True;TrustServerCertificate=False;
