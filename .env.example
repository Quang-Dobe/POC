KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
OPENBAO_HOST=localhost
OPENBAO_PORT=8200
BE_HOST=localhost
BE_PORT=5000
FE_HOST=localhost
FE_PORT=5173
DAB_HOST=localhost
DAB_PORT=8000
AGENT_HOST=localhost
AGENT_PORT=8082
REDIS_HOST=localhost
REDIS_PORT=6379
BAO_TOKEN=dev-only-token

TENANT_ID=poc
AUTH_INTERNAL_AUTHORITY=https://${BE_HOST}:${BE_PORT}
AUTH_INTERNAL_AUDIENCE=poc-internal


# BFF
AUTH_AUTHORITY=https://${KEYCLOAK_HOST}:${KEYCLOAK_PORT}/realms/${TENANT_ID}
AUTH_REDIRECT_URI=${AUTH_INTERNAL_AUTHORITY}/auth/callback
AUTH_FRONTEND_RETURN_URL=https://${FE_HOST}:${FE_PORT}
AUTH_BFF_CLIENT_ID=poc-bff

VAULT_ADDRESS=http://${OPENBAO_HOST}:${OPENBAO_PORT}
CORS_SPA_ORIGIN=https://${FE_HOST}:${FE_PORT}

# PROD only - Key Vault reader SP (App B); ignored in DEV (OpenBao).
# KEYVAULT_VAULT_URI=https://<vault-name>.vault.azure.net/
# AZURE_KV_CLIENT_ID=<kv-reader-app-client-id>
# AZURE_KV_CLIENT_SECRET=<kv-reader-app-secret>

# PROD only - Graph invite SP (App C); ignored in DEV (Keycloak).
# ENTRA_GRAPH_CLIENT_ID=<graph-invite-app-client-id>
# ENTRA_GRAPH_USER_DOMAIN=<verified-domain>.onmicrosoft.com

AGENT_GATEWAY_ENABLED=true
AGENT_ENVIRONMENT=Development

SESSION_COOKIE_NAME=poc.session
SESSION_TTL_MINUTES=30
SESSION_REDIS_ADDRESS=${REDIS_HOST}:${REDIS_PORT}

DATA_PROTECTION_APPLICATION_NAME=poc-auth
DATA_PROTECTION_REDIS_KEY=dp:poc-keyring

IDP_SIMULATOR_ISSUER=${AUTH_INTERNAL_AUTHORITY}
IDP_SIMULATOR_AUDIENCE=${AUTH_INTERNAL_AUDIENCE}
IDP_SIMULATOR_DOWNSTREAM_TOKEN_TTL_SECONDS=300
IDP_SIMULATOR_SIGNING_KEY_ID=poc-idp-key-1

KEYCLOAK_ADMIN_CLIENT_ID=poc-admin-cli


# FE
VITE_API_BASE_URL=${AUTH_INTERNAL_AUTHORITY}


# Agent
AZ_FOUNDRY_TENANT_ID=<sp-tenant-id>
AZ_FOUNDRY_SP_CLIENT_ID=<sp-client-id>
AZ_FOUNDRY_SP_CLIENT_SECRET=<sp-client-secret>
AZ_FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZ_FOUNDRY_MODEL_DEPLOYMENT_NAME=<model-deployment-name>


# DAB
DAB_ENVIRONMENT=Development
FABRIC_CONN_STRING=Server=<id>.datawarehouse.fabric.microsoft.com;Database=<WarehouseName>;Authentication=Active Directory Interactive;Encrypt=True;TrustServerCertificate=False;
