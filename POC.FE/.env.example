# Frontend build-time environment (Vite bakes VITE_* at build time => build-per-env).
#
# This file is the COMMITTED template. It contains NO secrets — the FE holds no
# client secret and, post-Step-L, no OIDC config: login is a server-side redirect to
# the BE `/auth/login`, and the browser holds only the opaque httpOnly session cookie.
#
# Local setup: copy the block you need into an UNTRACKED file Vite loads automatically:
#   - DEV build  -> .env.development   (or .env.local)
#   - PROD build -> .env.production
# Those .env.development / .env.production files are gitignored — create them locally;
# do NOT commit them. One flat set of VITE_* values is active per build.

# ----------------------------------------------------------------------------
# DEV — only the backend API origin survives (Step L pruned all VITE_OIDC_* vars).
# ----------------------------------------------------------------------------
# Backend API origin (placeholder — compose binds the real backend port).
VITE_API_BASE_URL=https://localhost:5000

# ----------------------------------------------------------------------------
# PROD — TEMPLATE ONLY. Fill <placeholders> locally in an untracked .env.production.
# ----------------------------------------------------------------------------
# VITE_API_BASE_URL=https://<backend-host>
