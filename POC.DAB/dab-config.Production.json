{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.0.8/dab.draft.schema.json",
  "runtime": {
    "host": {
      "mode": "production",
      "authentication": {
        "provider": "AzureAD",
        "jwt": {
          "audience": "@env('AUTH_INTERNAL_AUDIENCE')",
          "issuer": "@env('AUTH_INTERNAL_AUTHORITY')"
        }
      }
    }
  }
}
