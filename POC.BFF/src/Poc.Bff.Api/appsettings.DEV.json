{
  "Auth": {
    "Authority": "https://localhost:8080/realms/poc",
    "Audience": "poc-api",
    "RequireHttpsMetadata": true,
    "ClientId": "poc-bff",
    "RedirectUri": "https://localhost:5000/auth/callback",
    "FrontendReturnUrl": "https://localhost:5173"
  },
  "Cors": {
    "SpaOrigin": "https://localhost:5173"
  },
  "Vault": {
    "Address": "http://localhost:8200"
  },
  "Agent": {
    "Host": "localhost",
    "Port": 8082
  },
  "Session": {
    "CookieName": "poc.session",
    "TtlMinutes": 30,
    "RedisAddress": "localhost:6379"
  },
  "DataProtection": {
    "ApplicationName": "poc-auth",
    "RedisKey": "dp:poc-keyring"
  },
