      "bob": {
        "Roles": [ "manager" ],
        "Region": "Manhattan County"
      }
    },
    "DefaultRoles": null,
    "DefaultRegion": null
  },
  "Invite": {
    "DefaultRoles": [ "reader" ],
    "DefaultRegion": "Manhattan County",
    "TenantId": "poc"
  },
  "Keycloak": {
    "AdminBaseUrl": "https://localhost:8080",
    "Realm": "poc",
    "AdminClientId": "poc-admin-cli"
  }
