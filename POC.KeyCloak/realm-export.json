{
  "realm": "poc",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 600,
  "roles": {
    "realm": [
      {
        "name": "reader",
        "description": "DAB: may read all exposed entities"
      },
      {
        "name": "manager",
        "description": "DAB: may read entities; Geography rows filtered by the region claim"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "profile",
      "description": "Explicit profile scope. Step M fix r3: carries the username->preferred_username + full-name mappers; an empty-mapper scope emitted no claims, so the BE rejected every login on a missing preferred_username.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "Built-in email scope (same explicit-definition reason as profile).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "roles",
      "description": "Built-in roles scope, defined explicitly: a partial realm-export omits auto-created scopes, so without this tokens carry no realm_access/resource_access and poc-admin-cli gets 403 on Admin REST create-user.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "user.attribute": "foo",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "user.attribute": "foo",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience resolve",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-resolve-mapper",
          "consentRequired": false,
          "config": {}
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "poc-bff",
      "name": "POC.BFF (server-side OIDC authorization-code + PKCE client)",
      "description": "Server-side OIDC authorization-code client the BE runs post-cutover (Step E Q1/Q3): scope 'openid profile', validates id_token aud==poc-bff, PKCE-only (no DEV secret). redirectUri is the BFF HTTPS edge (Kestrel self-terminates TLS).",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "https://localhost:5000/auth/callback"
      ],
      "webOrigins": [
        "https://localhost:5000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:5000/*"
      },
      "defaultClientScopes": [
        "profile",
        "email"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "poc-admin-cli",
      "name": "POC.BFF invite admin (client_credentials, least-privilege manage-users/view-users)",
      "description": "Task 3: confidential service-account client for the Keycloak Admin REST invite flow. Secret read from the store seam (Keycloak--AdminClientSecret), not this file. Least privilege: manage-users + view-users only.",
      "enabled": true,
      "publicClient": false,
      "secret": "poc-admin-cli-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "roles"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Reader",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "realmRoles": [
        "reader"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "ManagerNY",
      "attributes": {
        "region": [
          "Manhattan County"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "realmRoles": [
        "manager"
      ]
    },
    {
      "username": "service-account-poc-admin-cli",
      "enabled": true,
      "serviceAccountClientId": "poc-admin-cli",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users"
        ]
      }
    }
  ]
}
